# Normalize line endings in the repository
* text=auto
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tla text eol=lf
*.pdf binary
*.bin binary
*.jpg binary
*.png binary
